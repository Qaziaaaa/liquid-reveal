{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "src/**/*.js", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" },
    { "src": "{img.png,helmet.png,favicon.svg,.nojekyll}", "use": "@vercel/static" }
  ],
  "cleanUrls": true
}